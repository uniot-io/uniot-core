{
  "name": "uniot-core",
  "version": "0.9.0",
  "description": "Firmware framework for ESP8266 and ESP32 devices on the Uniot platform: a non-blocking task scheduler, an event bus, WiFi provisioning with a captive portal, MQTT with COSE-signed messages, CBOR storage, and an embedded Lisp interpreter that runs scripts delivered over the air without reflashing.",
  "keywords": [
    "iot",
    "m2m",
    "automation",
    "async",
    "wifi",
    "app",
    "cloud",
    "web",
    "control",
    "edge-computing"
  ],
  "authors": [
    {
      "name": "Uniot Labs",
      "url": "https://github.com/uniot-io",
      "maintainer": true
    }
  ],
  "license": "GPL-3.0",
  "homepage": "https://uniot.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/uniot-io/uniot-core.git"
  },
  "frameworks": [
    "arduino"
  ],
  "platforms": [
    "espressif8266",
    "espressif32"
  ],
  "dependencies": [
    {
      "name": "uniot-cbor",
      "version": "https://github.com/uniot-io/uniot-cbor.git#0.2.4"
    },
    {
      "name": "uniot-lisp",
      "version": "https://github.com/uniot-io/uniot-lisp.git#0.4.0"
    },
    {
      "name": "uniot-pubsubclient",
      "version": "https://github.com/uniot-io/uniot-pubsubclient.git#0.2.8"
    },
    {
      "name": "uniot-crypto",
      "version": "https://github.com/uniot-io/uniot-crypto.git#0.2.2"
    },
    {
      "name": "uniot-esp-async-web-server",
      "version": "https://github.com/uniot-io/uniot-esp-async-web-server.git#3.7.7"
    }
  ],
  "export": {
    "exclude": [
      ".clang-format",
      ".git",
      ".gitignore",
      ".gitmodules",
      ".github",
      "platformio.ini",
      "ci",
      "scripts",
      "src",
      "tools",
      "lib/WebPages/web-pages"
    ]
  },
  "build": {
    "srcDir": ".",
    "flags": [
      "-I lib/Uniot",
      "-I lib/Core",
      "-I lib/AppKit",
      "-I lib/WebPages",
      "-I lib/Core/EventBus",
      "-I lib/Core/Scheduler",
      "-I lib/Core/Network",
      "-I lib/Core/Storage",
      "-I lib/Core/Utils",
      "-I lib/Core/CBORWrapper",
      "-I lib/Core/LispWrapper",
      "-I lib/Core/MQTTWrapper",
      "-I lib/Core/Register",
      "-I lib/Core/Hardware",
      "-I lib/Core/Date"
    ],
    "srcFilter": [
      "+<lib/Uniot/*>",
      "+<lib/Core/*>",
      "+<lib/AppKit/*>",
      "+<lib/WebPages/*>"
    ]
  }
}
